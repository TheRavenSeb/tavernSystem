{
  "name": "tavern-keeper-web",
  "version": "1.0.0",
  "private": true,
  "description": "Express web control panel for a TavernLib server",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "build:exe": "pkg . --targets node20-win-x64 --output dist/TavernKeeper.exe"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "tavern-client": "^1.0.1"
  },
  "bin": "index.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "views/**/*"
    ]
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.5.0"
  }
}
